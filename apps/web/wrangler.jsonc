// Cloudflare Workers 설정 — ADR-0002(2026-11-27 개정), architecture §5.1·§8
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "caddy-haru",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // 공개 값은 코드에 둔다. PROXY_SECRET은 대시보드 "런타임 변수 및 시크릿"에 비밀로만 넣는다(코드·빌드 변수 금지).
  "vars": {
    "API_ORIGIN": "https://caddy-haru.onrender.com",
  },
  // 대시보드에서 직접 넣은 변수를 배포 때 지우지 않는다(비밀은 원래 유지됨).
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 모르는 경로는 index.html (React Router가 처리)
    "not_found_handling": "single-page-application",
    // /api/*만 Worker 코드가 먼저 받는다. 나머지 정적 요청은 무료·무제한(Worker 호출 한도에 안 들어감)
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
}
