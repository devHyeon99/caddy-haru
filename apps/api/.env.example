# 로컬 개발용 (architecture §8.1). 복사: cp .env.example .env — .env는 커밋하지 않는다
# 로컬 DB: 저장소 루트에서 docker compose up -d db
DATABASE_URL=postgres://caddy_haru:caddy_haru@localhost:5432/caddy_haru
# vite dev 서버 프록시(apps/web/vite.config.ts)가 같은 값을 붙인다
PROXY_SECRET=dev-proxy-secret
APP_ORIGIN=http://localhost:5173
# 카카오 개발자 콘솔 값. 로컬 로그인을 하려면 Redirect URI에 아래 주소를 추가 등록해야 한다
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/api/auth/kakao/callback
